local hopping = false
local function doHop()
    if hopping then return end
    hopping = true
    setStatus("QUEUING & HOPPING...", C.blue)
    AddLog("INITIATING SERVER HOP", C.blue)

    local q = (syn and syn.queue_on_teleport)
           or (queue_on_teleport)
           or (fluxus and fluxus.queue_on_teleport)

    if q then
        local ok, src = pcall(function() return game:HttpGet(self_url) end)
        if ok and src and #src > 10 then
            pcall(function() q(src) end)
            AddLog("QUEUED SELF-SCRIPT OK", C.accent)
        else
            AddLog("SELF-FETCH FAILED — QUEUE SKIPPED", C.red)
        end
    else
        AddLog("NO QUEUE FUNC FOUND", C.red)
    end

    local api = "https://games.roblox.com/v1/games/" .. PlaceID
             .. "/servers/Public?sortOrder=" .. currentSort .. "&limit=100"
    if foundAnything ~= "" then api = api .. "&cursor=" .. foundAnything end

    local ok2, resp = pcall(function() return game:HttpGet(api) end)
    if not ok2 or not resp then
        AddLog("API FETCH FAILED", C.red)
        hopping = false
        return
    end

    local site = pcall(function() return HttpService:JSONDecode(resp) end) and HttpService:JSONDecode(resp)
    if not site or not site.data or #site.data == 0 then
        AddLog("NO SERVER DATA RETURNED", C.red)
        foundAnything = ""
        currentSort = (currentSort == "Asc" and "Desc" or "Asc")
        updateCard("sort", currentSort == "Asc" and "ASCENDING" or "DESCENDING")
        hopping = false
        return
    end

    if site.nextPageCursor and site.nextPageCursor ~= "null" then
        foundAnything = site.nextPageCursor
    else
        foundAnything = ""
        currentSort = (currentSort == "Asc" and "Desc" or "Asc")
        updateCard("sort", currentSort == "Asc" and "ASCENDING" or "DESCENDING")
    end

    for _, v in pairs(site.data) do
        local ID = tostring(v.id)
        local Possible = true

        if tonumber(v.maxPlayers) > tonumber(v.playing) and ID ~= currentJobId then
            for i, existing in ipairs(AllIDs) do
                if i > 1 and ID == tostring(existing) then
                    Possible = false
                    break
                end
            end

            if Possible then
                table.insert(AllIDs, ID)
                SaveToDB()
                totalHops = totalHops + 1
                updateCard("hops", totalHops)
                AddLog("HOPPING → " .. v.playing .. "/" .. v.maxPlayers .. " PLAYERS", C.accent)
                setStatus("TELEPORTING...", C.accent)
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(PlaceID, ID, LocalPlayer)
                end)
                task.wait(10)
                break
            else
                AddLog("SKIP (VISITED): " .. string.sub(ID, 1, 12), C.muted)
            end
        end
    end

    hopping = false
end

