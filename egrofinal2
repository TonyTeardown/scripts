--              DATABASE
-- ════════════════════════════════════════════════
local function SaveToDB()
    local ok, err = pcall(function()
        writefile(databaseName, HttpService:JSONEncode(AllIDs))
    end)
    updateCard("db", #AllIDs .. " servers")
    if not ok then AddLog("DB WRITE FAIL: " .. tostring(err), C.red) end
end

local function LoadDB()
    local ok, result = pcall(function()
        return HttpService:JSONDecode(readfile(databaseName))
    end)
    if ok and type(result) == "table" then
        if result[1] ~= actualHour then
            AllIDs = {actualHour}
            SaveToDB()
            AddLog("NEW SESSION — DB RESET", C.yellow)
        else
            AllIDs = result
            AddLog("DB LOADED: " .. #AllIDs .. " servers", C.accent)
        end
    else
        AllIDs = {actualHour}
        SaveToDB()
        AddLog("DB CREATED FRESH", C.muted)
    end
    updateCard("db", #AllIDs .. " servers")
end

