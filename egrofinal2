-- ════════════════════════════════════════════════
--              LOG FUNCTION
-- ════════════════════════════════════════════════
local logEntry = 0
local function AddLog(msg, col)
    logEntry = logEntry + 1
    table.insert(logLines, {msg = msg, col = col or C.white, t = os.date("%X")})
    if #logLines > MAX_LOGS then table.remove(logLines, 1) end

    -- trim old labels
    local children = logScroll:GetChildren()
    local count = 0
    for _, c in ipairs(children) do
        if c:IsA("TextLabel") then count = count + 1 end
    end
    if count > MAX_LOGS then
        for _, c in ipairs(logScroll:GetChildren()) do
            if c:IsA("TextLabel") then
                c:Destroy()
                break
            end
        end
    end

    local l = make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = "  " .. os.date("%X") .. "  " .. msg,
        TextColor3 = col or C.white,
        Font = Enum.Font.Code,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = logEntry,
    })
    l.Parent = logScroll
    logScroll.CanvasSize = UDim2.new(0, 0, 0, logLayout.AbsoluteContentSize.Y + 12)
    logScroll.CanvasPosition = Vector2.new(0, logLayout.AbsoluteContentSize.Y)
    logCountLabel.Text = #logLines .. " entries"
end

