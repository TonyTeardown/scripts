end

local function SaveToDB()
    local encoded = HttpService:JSONEncode(AllIDs)
    writefile(databaseName, encoded)
    L4.Text = "DATABASE: " .. #AllIDs
end

local function LoadDB()
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(databaseName))
    end)
    if success and type(result) == "table" then
        if result[1] ~= actualHour then
            AllIDs = {actualHour}
            SaveToDB()
        else
            AllIDs = result
        end
    else
        AllIDs = {actualHour}
        SaveToDB()
    end
    L4.Text = "DATABASE: " .. #AllIDs
end

