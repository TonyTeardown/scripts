local function TPReturner()
    local Site;
    local api = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=' .. currentSort .. '&limit=100'
    if foundAnything ~= "" then api = api .. '&cursor=' .. foundAnything end
    
    local ok, resp = pcall(function() return game:HttpGet(api) end)
    if ok and resp then
        Site = HttpService:JSONDecode(resp)
        if not Site or not Site.data or #Site.data == 0 then
            foundAnything = ""
            currentSort = (currentSort == "Asc" and "Desc" or "Asc")
            L6.Text = "SORT: " .. currentSort:upper()
            return
        end
        if Site.nextPageCursor and Site.nextPageCursor ~= "null" then
            foundAnything = Site.nextPageCursor
        else
            foundAnything = ""
            currentSort = (currentSort == "Asc" and "Desc" or "Asc")
            L6.Text = "SORT: " .. currentSort:upper()
        end
        for _, v in pairs(Site.data) do
            local Possible = true
            local ID = tostring(v.id)
            if tonumber(v.maxPlayers) > tonumber(v.playing) and ID ~= currentJobId then
                for i, Existing in pairs(AllIDs) do
                    if i > 1 and ID == tostring(Existing) then 
                        Possible = false
                        break 
                    end
                end
                if Possible then
                    table.insert(AllIDs, ID)
                    SaveToDB()
                    AddLog("HOPPING TO: " .. v.playing .. " PLRS", Color3.fromRGB(0, 255, 100))
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(PlaceID, ID, LocalPlayer)
                    end)
                    task.wait(8)
                end
            end
        end
    else
        AddLog("API THROTTLE - RETRYING", Color3.new(1,0,0))
        task.wait(5)
    end
end

