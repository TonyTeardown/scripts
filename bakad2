local success_text = "No backdoored"
local script_url = "https://raw.githubusercontent.com/jLn0n/beckdeer-skenner/main/src/main.lua"
local self_url = "https://raw.githubusercontent.com/TonyTeardown/scripts/refs/heads/main/bakad2"

local FinalScript = [===[
    repeat task.wait() until game:IsLoaded()

    local LogService = game:GetService("LogService")
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")

    local success_text = "]===] .. success_text .. [===[" 
    local script_url = "]===] .. script_url .. [===[" 
    local self_url = "]===] .. self_url .. [===[" 
    local found_success = false

    local function serverHop()
        -- Handle Queue on Teleport
        local queue = (syn and syn.queue_on_teleport) or (queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        if queue then
            local ok, src = pcall(function() return game:HttpGet(self_url) end)
            if ok and src then queue(src) end
        end

        -- Your Custom JSON Hopper Logic
        local PlaceID = game.PlaceId
        local AllIDs = {}
        local foundAnything = ""
        local actualHour = os.date("!*t").hour
        
        local File = pcall(function()
            AllIDs = HttpService:JSONDecode(readfile("NotSameServers.json"))
        end)
        
        if not File then
            table.insert(AllIDs, actualHour)
            writefile("NotSameServers.json", HttpService:JSONEncode(AllIDs))
        end

        local function TPReturner()
            local Site;
            local s, res = pcall(function()
                if foundAnything == "" then
                    return game:HttpGet('https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100')
                else
                    return game:HttpGet('https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100&cursor=' .. foundAnything)
                end
            end)

            if not s then return end
            Site = HttpService:JSONDecode(res)

            if Site.nextPageCursor and Site.nextPageCursor ~= "null" and Site.nextPageCursor ~= nil then
                foundAnything = Site.nextPageCursor
            end

            local num = 0;
            for i,v in pairs(Site.data) do
                local Possible = true
                local ID = tostring(v.id)
                if tonumber(v.maxPlayers) > tonumber(v.playing) then
                    for _,Existing in pairs(AllIDs) do
                        if num ~= 0 then
                            if ID == tostring(Existing) then
                                Possible = false
                            end
                        else
                            if tonumber(actualHour) ~= tonumber(Existing) then
                                pcall(function()
                                    delfile("NotSameServers.json")
                                    AllIDs = {}
                                    table.insert(AllIDs, actualHour)
                                end)
                            end
                        end
                        num = num + 1
                    end
                    
                    if Possible == true then
                        table.insert(AllIDs, ID)
                        task.wait()
                        pcall(function()
                            writefile("NotSameServers.json", HttpService:JSONEncode(AllIDs))
                            task.wait()
                            TeleportService:TeleportToPlaceInstance(PlaceID, ID, game.Players.LocalPlayer)
                        end)
                        task.wait(4)
                    end
                end
            end
        end

        -- Start the teleport loop
        while task.wait(1) do
            pcall(function()
                TPReturner()
                if foundAnything ~= "" then
                    TPReturner()
                end
            end)
        end
    end

    -- Prevent execution stacking
    if _G.ScanningActive then return end
    _G.ScanningActive = true

    local connection
    connection = LogService.MessageOut:Connect(function(message)
        if string.find(message:lower(), success_text:lower(), 1, true) then
            found_success = true
        end
    end)

    print("Executing loadstring...")
    local run_success, err = pcall(function()
        loadstring(game:HttpGet(script_url))()
    end)

    task.wait(1) -- Short wait for logs to catch up
    connection:Disconnect()
    _G.ScanningActive = false

    if found_success then
        print("Success detected! Starting hop...")
        serverHop()
    else
        print("Phrase not found. Staying in server.")
    end
]===]

loadstring(FinalScript)()
