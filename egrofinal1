-- [[ CORE LOGIC: DATABASE ]] --
local function SaveToDB()
    local success, err = pcall(function()
        local data = HttpService:JSONEncode(AllIDs)
        writefile(databaseName, data)
    end)
    L4.Text = "DB COUNT: " .. #AllIDs
    if not success then
        AddLog("WRITE FAIL: " .. tostring(err), Color3.new(1, 0.4, 0.4))
    end
end

local function LoadDB()
    local exists = pcall(function() return readfile(databaseName) end)
    if not exists then
        AllIDs = {actualHour}
        SaveToDB()
        return
    end
    
    local success, result = pcall(function()
        local content = readfile(databaseName)
        return HttpService:JSONDecode(content)
    end)
    
    if success and type(result) == "table" then
        if result[1] ~= actualHour then
            AllIDs = {actualHour}
            SaveToDB()
            AddLog("NEW HOUR: RESETTING DB", Color3.fromRGB(255, 200, 0))
        else
            AllIDs = result
            AddLog("DB LOADED: " .. #AllIDs .. " ENTRIES", Color3.fromRGB(0, 200, 255))
        end
    else
        AllIDs = {actualHour}
        SaveToDB()
    end
    L4.Text = "DB COUNT: " .. #AllIDs
end

