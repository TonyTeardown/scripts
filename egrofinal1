-- [[ TELEPORT ENGINE ]] --
local function TPReturner()
    local Site;
    local api_url = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=' .. currentSort .. '&limit=100'
    
    if foundAnything ~= "" then 
        api_url = api_url .. '&cursor=' .. foundAnything 
    end
    
    local ok, resp = pcall(function() 
        return game:HttpGet(api_url) 
    end)
    
    if ok and resp then
        Site = HttpService:JSONDecode(resp)
        
        if not Site or not Site.data or #Site.data == 0 then
            foundAnything = ""
            currentSort = (currentSort == "Asc" and "Desc" or "Asc")
            L6.Text = "SORT: " .. currentSort:upper()
            AddLog("STAGNATION: FLIPPING SORT", Color3.fromRGB(255, 150, 0))
            return
        end
        
        if Site.nextPageCursor and Site.nextPageCursor ~= "null" then
            foundAnything = Site.nextPageCursor
        else
            foundAnything = ""
            currentSort = (currentSort == "Asc" and "Desc" or "Asc")
            L6.Text = "SORT: " .. currentSort:upper()
        end
        
        for _, server in pairs(Site.data) do
            local ID = tostring(server.id)
            local currentCount = tonumber(server.playing)
            local maxCount = tonumber(server.maxPlayers)
            
            if maxCount > currentCount and ID ~= currentJobId then
                local isNew = true
                for i, Existing in pairs(AllIDs) do
                    if i > 1 and ID == tostring(Existing) then 
                        isNew = false
                        break 
                    end
                end
                
                if isNew == true then
                    table.insert(AllIDs, ID)
                    SaveToDB()
                    AddLog("HOPPING TO NODE: .." .. string.sub(ID, -5), Color3.new(0, 1, 0))
                    
                    local tp_success, tp_error = pcall(function()
                        TeleportService:TeleportToPlaceInstance(PlaceID, ID, LocalPlayer)
                    end)
                    
                    if not tp_success then
                        AddLog("TP FAIL: RETRYING...", Color3.new(1, 0, 0))
                    end
                    task.wait(5)
                end
            end
        end
    else
        AddLog("API OVERLOAD: COOLING DOWN", Color3.new(1, 0, 0))
        task.wait(10)
    end
end

