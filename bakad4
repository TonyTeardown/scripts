local success_text = "No backdoored"
local script_url = "https://raw.githubusercontent.com/jLn0n/beckdeer-skenner/main/src/main.lua"
local self_url = "https://raw.githubusercontent.com/TonyTeardown/scripts/refs/heads/main/bakad4"

local FinalScript = [===[
    repeat task.wait() until game:IsLoaded()

    local LogService = game:GetService("LogService")
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")
    local CoreGui = game:GetService("CoreGui")

    -- UI Setup
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ScannerStatus"
    screenGui.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 250, 0, 70)
    frame.Position = UDim2.new(1, -260, 1, -80)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, 0, 0.5, 0)
    statusLabel.Text = "Status: Initializing..."
    statusLabel.TextColor3 = Color3.new(1, 1, 1)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Font = Enum.Font.GothamSemibold
    statusLabel.TextSize = 14
    statusLabel.Parent = frame

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1, 0, 0.5, 0)
    infoLabel.Position = UDim2.new(0, 0, 0.5, 0)
    infoLabel.Text = "Waiting for scanner..."
    infoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    infoLabel.BackgroundTransparency = 1
    infoLabel.Font = Enum.Font.Gotham
    infoLabel.TextSize = 12
    infoLabel.Parent = frame

    local function updateStatus(txt, info)
        statusLabel.Text = "Status: " .. tostring(txt)
        if info then infoLabel.Text = info end
    end

    local function serverHop()
        updateStatus("Preparing Hop...", "Checking Queue...")
        local queue = (syn and syn.queue_on_teleport) or (queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        if queue then
            local ok, src = pcall(function() return game:HttpGet(self_url) end)
            if ok and src then queue(src) end
        end

        local PlaceID = game.PlaceId
        local AllIDs = {}
        local foundAnything = ""
        local actualHour = os.date("!*t").hour
        
        local File = pcall(function()
            AllIDs = HttpService:JSONDecode(readfile("NotSameServers.json"))
        end)
        
        if not File then
            table.insert(AllIDs, actualHour)
            writefile("NotSameServers.json", HttpService:JSONEncode(AllIDs))
        end

        local function TPReturner()
            updateStatus("Fetching Servers...", "Visited: " .. #AllIDs)
            local Site;
            local s, res = pcall(function()
                if foundAnything == "" then
                    return game:HttpGet('https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100')
                else
                    return game:HttpGet('https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100&cursor=' .. foundAnything)
                end
            end)

            if not s then return end
            Site = HttpService:JSONDecode(res)

            if Site.nextPageCursor and Site.nextPageCursor ~= "null" and Site.nextPageCursor ~= nil then
                foundAnything = Site.nextPageCursor
            end

            for i,v in pairs(Site.data) do
                local Possible = true
                local ID = tostring(v.id)
                if tonumber(v.maxPlayers) > tonumber(v.playing) then
                    for _,Existing in pairs(AllIDs) do
                        if ID == tostring(Existing) then
                            Possible = false
                        end
                    end
                    
                    if Possible == true then
                        updateStatus("Teleporting!", "ID: .." .. string.sub(ID, -5))
                        table.insert(AllIDs, ID)
                        pcall(function()
                            writefile("NotSameServers.json", HttpService:JSONEncode(AllIDs))
                            TeleportService:TeleportToPlaceInstance(PlaceID, ID, game.Players.LocalPlayer)
                        end)
                        task.wait(2)
                    end
                end
            end
        end

        while task.wait(0.5) do
            pcall(TPReturner)
        end
    end

    if _G.ScanningActive then 
        screenGui:Destroy()
        return 
    end
    _G.ScanningActive = true

    local connection
    local scanner_finished = false
    connection = LogService.MessageOut:Connect(function(message)
        if string.find(message:lower(), success_text:lower(), 1, true) then
            found_success = true
        end
        -- Detect when the scanner script has actually finished its prints
        if string.find(message:lower(), "scan complete") or string.find(message:lower(), "finished") then
            scanner_finished = true
        end
    end)

    updateStatus("Running Scanner...", "Analyzing Game...")
    
    local run_success, err = pcall(function()
        loadstring(game:HttpGet(script_url))()
    end)

    -- NEW: Wait loop to give the scanner time to work
    local timeout = 0
    while not scanner_finished and timeout < 30 do
        task.wait(1)
        timeout = timeout + 1
        updateStatus("Scanning...", "Time: " .. timeout .. "s / 30s")
        if found_success then break end -- Exit early if we already found what we want
    end

    connection:Disconnect()
    _G.ScanningActive = false

    if found_success then
        updateStatus("Match Found!", "Starting Hopper...")
        serverHop()
    else
        updateStatus("No Match Found", "Staying here.")
        task.wait(5)
        screenGui:Destroy()
    end
]===]

loadstring(FinalScript)()
