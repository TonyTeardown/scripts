end

local function LoadDB()
    local ok,r = pcall(function() return Http:JSONDecode(readfile(dbName)) end)
    if ok and type(r)=="table" then
        if r[1]~=hour then
            AllIDs={hour} SaveDB() AddLog("NEW SESSION — DB RESET",OR)
        else
            AllIDs=r AddLog("DB LOADED: "..(#AllIDs-1).." entries",AD)
        end
    else
        AllIDs={hour} SaveDB() AddLog("DB CREATED FRESH",MU)
    end
    updCard("db", #AllIDs.." svrs")
end

