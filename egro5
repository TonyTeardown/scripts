end

local logIdx = 0
local function AddLog(msg, col)
    logIdx = logIdx + 1
    logCount = logCount + 1

    local children = logScroll:GetChildren()
    local cnt = 0
    for _,c in ipairs(children) do if c:IsA("TextLabel") then cnt=cnt+1 end end
    if cnt >= MAX_LOG then
        for _,c in ipairs(logScroll:GetChildren()) do
            if c:IsA("TextLabel") then c:Destroy() break end
        end
    end

    local l = make("TextLabel",{
        Size=UDim2.new(1,0,0,15),
        BackgroundTransparency=1,
        Text=os.date("%X").."  "..msg,
        TextColor3=col or WH,
        Font=Enum.Font.Code,
        TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,
        LayoutOrder=logIdx,
        TextTransparency=1,
        ZIndex=5,
    },logScroll)

    tw(l,{TextTransparency=0},0.25)
    logScroll.CanvasSize = UDim2.new(0,0,0,logLL.AbsoluteContentSize.Y+12)
    logScroll.CanvasPosition = Vector2.new(0,logLL.AbsoluteContentSize.Y)
    logCntL.Text = logCount.." lines"
end

