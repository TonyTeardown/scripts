-- ══════════════════════════════════════════
--  SERVER HOP
-- ══════════════════════════════════════════
local hopping = false
local function doHop()
    if hopping then return end
    hopping = true
    setStatus("SEARCHING SERVERS...", BL)

    local q = (syn and syn.queue_on_teleport)
           or (queue_on_teleport)
           or (fluxus and fluxus.queue_on_teleport)

    if q then
        local ok,src = pcall(function() return game:HttpGet(self_url) end)
        if ok and src and #src > 10 then
            pcall(function() q(src) end)
            AddLog("QUEUED SELF OK",AD)
        else
            AddLog("SELF-FETCH FAIL — NO QUEUE",RE)
        end
    else
        AddLog("NO QUEUE FUNCTION FOUND",RE)
    end

    local api = "https://games.roblox.com/v1/games/"..placeId.."/servers/Public?sortOrder="..sort.."&limit=100"
    if cursor~="" then api=api.."&cursor="..cursor end

    local ok2,resp = pcall(function() return game:HttpGet(api) end)
    if not ok2 or not resp then
        AddLog("API FETCH FAILED",RE) hopping=false return
    end

    local site
    pcall(function() site=Http:JSONDecode(resp) end)
    if not site or not site.data or #site.data==0 then
        AddLog("NO DATA — FLIPPING SORT",OR)
        cursor="" sort=(sort=="Asc" and "Desc" or "Asc")
        updCard("sort", sort=="Asc" and "ASC" or "DESC")
        hopping=false return
    end

    if site.nextPageCursor and site.nextPageCursor~="null" then
        cursor=site.nextPageCursor
    else
        cursor="" sort=(sort=="Asc" and "Desc" or "Asc")
        updCard("sort", sort=="Asc" and "ASC" or "DESC")
    end

    for _,v in pairs(site.data) do
        local ID = tostring(v.id)
        local canHop = true
        if tonumber(v.maxPlayers)>tonumber(v.playing) and ID~=jobId then
            for i,e in ipairs(AllIDs) do
                if i>1 and ID==tostring(e) then canHop=false break end
            end
            if canHop then
                table.insert(AllIDs,ID)
                SaveDB()
                hops=hops+1
                updCard("hops",hops,A)
                AddLog("HOP → "..v.playing.."/"..v.maxPlayers.." players",A)
                setStatus("TELEPORTING...",CY)
                -- flash cyan
                tw(mStroke,{Color=CY,Thickness=4},0.1)
                task.delay(0.4,function() tw(mStroke,{Color=A,Thickness=2},0.6) end)
                pcall(function() TP:TeleportToPlaceInstance(placeId,ID,LP) end)
                task.wait(10)
                break
            else
                AddLog("SKIP (seen): "..string.sub(ID,1,14),MU)
            end
        end
    end
    hopping=false
end

