local function elapsed()
    local s = os.time() - tStart
    return ("%02d:%02d:%02d"):format(math.floor(s/3600), math.floor(s/60)%60, s%60)
end

local function tw(obj, props, t, st, dir)
    TW:Create(obj, TweenInfo.new(t or .25, st or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props):Play()
end

local function make(cls, props, par)
    local o = Instance.new(cls)
    for k,v in pairs(props) do o[k]=v end
    if par then o.Parent=par end
    return o
end

local function corner(r,p) return make("UICorner",{CornerRadius=UDim.new(0,r)},p) end
local function stroke(c,t,p)
    return make("UIStroke",{Color=c,Thickness=t,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},p)
end

