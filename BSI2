    task.wait(0.2)
    tw(mf,{BackgroundTransparency=0,Size=UDim2.new(0,W,0,H)},0.7,Enum.EasingStyle.Back)
end)

-- ══════════════════════════════════════════
--  MAIN — runs once per server
-- ══════════════════════════════════════════
LoadData()

-- wait for game to fully load remotes
setStatus("WAITING FOR GAME TO LOAD...", OR)
task.wait(5)

setStatus("COUNTING REMOTES...", OR)
local thisCount = countRemotes()
remoteData[jobId] = thisCount
updCard("remotes", thisCount, WH)

-- set or update baseline (lowest seen = cleanest server)
if baseline == nil then
    baseline = thisCount
    remoteData._baseline = baseline
elseif thisCount < baseline then
    baseline = thisCount
    remoteData._baseline = baseline
end

SaveData()

local diff = thisCount - baseline
updCard("baseline", baseline, AD)
updCard("diff", (diff>=0 and "+" or "")..diff, diff>0 and OR or A)

AddServerLog(jobId, thisCount, diff, diff>0)

print("[TITAN] Job: "..jobId.." | Remotes: "..thisCount.." | Baseline: "..baseline.." | Diff: "..diff)

-- ══════════════════════════════════════════
--  DECISION — auto, no user input needed
-- ══════════════════════════════════════════
if diff > 0 then
    -- MORE remotes than baseline = infected, stop and alert
    setStatus("🔴 INFECTED! +"..diff.." EXTRA REMOTES", RE)
    mStroke.Color=RE sDot.BackgroundColor3=RE
    mf.Draggable=true

    task.spawn(function()
        for i=1,6 do
            tw(mStroke,{Color=Color3.fromRGB(255,80,80),Thickness=5},0.15)
            task.wait(0.15)
            tw(mStroke,{Color=RE,Thickness=2},0.15)
            task.wait(0.15)
        end
    end)

    sendAlert(thisCount, baseline, diff)
    print("[TITAN] 🔴 INFECTED — +"..diff.." remotes over baseline")

    -- show close button
    local closeB = make("TextButton",{
        Size=UDim2.new(0,BTN_W,0,40),
        Position=UDim2.new(0,16+(BTN_W/2)+5,0,BTN_Y),
        BackgroundColor3=Color3.fromRGB(30,30,30),
        Text="✕  CLOSE",
        TextColor3=WH,
        Font=Enum.Font.GothamBold,
        TextSize=11,
        BorderSizePixel=0,
        ZIndex=3,
        BackgroundTransparency=1,
    },mf)
    corner(10,closeB)
    stroke(BD,1,closeB)
    tw(closeB,{BackgroundTransparency=0},0.4)
    btnHov(closeB,Color3.fromRGB(80,80,80),Color3.fromRGB(30,30,30))
    closeB.MouseButton1Click:Connect(function()
        tw(mf,{BackgroundTransparency=1,Size=UDim2.new(0,W,0,48)},0.4)
        task.wait(0.45)
        sg:Destroy()
        _G.TitanRunning=nil
    end)

else
    -- same or less = clean, auto hop
    setStatus("✅ CLEAN ("..thisCount.." remotes) — HOPPING", A)
    print("[TITAN] ✅ Clean — hopping")

    -- queue self once before hop loop
    local q=(syn and syn.queue_on_teleport) or (queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if q then
        local ok,src=pcall(function() return game:HttpGet(self_url) end)
        if ok and src and #src>10 then
            pcall(function() q(src) end)
        end
    end

    while task.wait(1) do
        pcall(doHop)
    end
end
