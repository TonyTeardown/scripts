local function SaveData()
    pcall(function() writefile(dataFile, Http:JSONEncode(remoteData)) end)
end

local function LoadData()
    local ok,r = pcall(function() return Http:JSONDecode(readfile(dataFile)) end)
    if ok and type(r)=="table" then
        if r._hour ~= hour then
            remoteData={_hour=hour}
            SaveData()
        else
            remoteData=r
            baseline=remoteData._baseline or nil
        end
    else
        remoteData={_hour=hour}
        SaveData()
    end
end

